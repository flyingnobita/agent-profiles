#!/usr/bin/env bash
set -euo pipefail

DEV_MODE=0
if [[ "${1:-}" == "--worktree" ]]; then
  DEV_MODE=1
  shift
fi

SRC="${1:-$PWD}"
SRC=$(cd "$SRC" && pwd)

fail() {
  echo "check-install: FAIL: $*" >&2
  exit 1
}

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT

mkdir -p "$T/src" "$T/home_default" "$T/home_copy" "$T/npm_cache"

run_in_home() {
  local home="$1"
  shift
  MISE_YES=1 MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}" \
    env -i PATH="$PATH" \
    HOME="$home" \
    XDG_CONFIG_HOME="$home/.config" \
    XDG_DATA_HOME="$home/.local/share" \
    XDG_STATE_HOME="$home/.local/state" \
    XDG_CACHE_HOME="$home/.cache" \
    CODEX_HOME="$home/.codex" \
    CLAUDE_CONFIG_DIR="$home/.claude" \
    OPENCODE_CONFIG_DIR="$home/.opencode" \
    DISABLE_TELEMETRY=1 \
    npm_config_cache="$T/npm_cache" \
    "$@"
}

# Step 1: Populate disposable copy of source
if [[ $DEV_MODE -eq 1 ]]; then
  echo "check-install: copying uncommitted worktree files..."
  git -C "$SRC" ls-files -co --exclude-standard | tar -cf - -C "$SRC" -T - | tar -xf - -C "$T/src"
else
  echo "check-install: extracting git archive HEAD..."
  git -C "$SRC" archive HEAD | tar -x -C "$T/src"
fi

# Step 2: Test discovery via skills add --list with complete environment isolation
echo "check-install: testing skills discovery in disposable source..."
LIST_OUT=$(
  run_in_home "$T/home_default" skills add "$T/src" --list 2>&1
) || fail "skills add --list failed: $LIST_OUT"

echo "$LIST_OUT" | grep -q "flyingnobita-agent-profiles" || fail "skills add --list did not find flyingnobita-agent-profiles:\n$LIST_OUT"

# Step 3: Install in default mode into home_default (symlink mode)
echo "check-install: installing into home_default (symlink mode)..."
INSTALL1_OUT=$(
  run_in_home "$T/home_default" skills add "$T/src" -g -y --skill flyingnobita-agent-profiles --agent claude-code codex antigravity-cli opencode 2>&1
) || fail "install default failed: $INSTALL1_OUT"

# Step 4: Install in --copy mode into home_copy
echo "check-install: installing into home_copy (--copy mode)..."
INSTALL2_OUT=$(
  run_in_home "$T/home_copy" skills add "$T/src" -g -y --copy --skill flyingnobita-agent-profiles --agent claude-code codex antigravity-cli opencode 2>&1
) || fail "install --copy failed: $INSTALL2_OUT"

# Step 5: Delete disposable source
echo "check-install: removing disposable source copy..."
rm -rf "$T/src"

# Step 6: Create separate working directory to run installed helpers
separate_cwd="$T/separate_repo"
mkdir -p "$separate_cwd"
git -C "$separate_cwd" init -q

# Step 7: Verify installed instances in both modes
for mode in "default" "copy"; do
  home_dir="$T/home_$mode"
  echo "check-install: verifying installed instance in home_$mode..."

  # Verify all 4 agent registrations:
  # claude-code registers under ~/.claude/skills/flyingnobita-agent-profiles
  # codex, antigravity-cli, opencode register under ~/.agents/skills/flyingnobita-agent-profiles
  claude_target="$home_dir/.claude/skills/flyingnobita-agent-profiles"
  universal_target="$home_dir/.agents/skills/flyingnobita-agent-profiles"

  [[ -d "$claude_target" ]] || fail "claude-code registration target missing: $claude_target"
  [[ -d "$universal_target" ]] || fail "universal agent registration target missing: $universal_target"

  if [[ "$mode" == "copy" ]]; then
    [[ ! -L "$claude_target" ]] || fail "claude_target is a symlink in copy mode"
    [[ ! -L "$universal_target" ]] || fail "universal_target is a symlink in copy mode"
  else
    [[ -L "$claude_target" ]] || fail "claude_target is not a symlink in default mode"
    [[ ! -L "$universal_target" ]] || fail "universal_target is an unexpected symlink in default mode"
  fi

  # Path safety check: ensure no installed symlink references disposable source or repo source
  while IFS= read -r -d '' link; do
    target=$(readlink -f "$link" || true)
    if [[ "$target" == "$T/src"* || "$target" == "$SRC"* ]]; then
      fail "installed symlink ($link -> $target) references disposable source or repository source"
    fi
  done < <(find "$home_dir" -type l -print0)

  # Verify targets and run installed helper from separate cwd with source absent
  for target in "$claude_target" "$universal_target"; do
    [[ -f "$target/SKILL.md" ]] || fail "SKILL.md missing in $target"
    [[ -f "$target/VERSION" ]] || fail "VERSION missing in $target"
    [[ -f "$target/scripts/agent-profiles" ]] || fail "helper script missing in $target"
    [[ -f "$target/scripts/lib/common.sh" ]] || fail "common.sh missing in $target"
    [[ -f "$target/scripts/lib/commands/doctor.sh" ]] || fail "doctor.sh missing in $target"
    for ag in claude codex agy opencode; do
      [[ -f "$target/scripts/lib/agents/$ag.sh" ]] || fail "agent module $ag.sh missing in $target"
    done
    for ref in questions troubleshooting repository-operations machine-setup lifecycle compatibility; do
      [[ -f "$target/references/$ref.md" ]] || fail "reference $ref.md missing in $target"
    done
    for ag_ref in claude-code codex antigravity opencode; do
      [[ -f "$target/references/agents/$ag_ref.md" ]] || fail "agent reference $ag_ref.md missing in $target"
    done

    # Run helper from separate cwd with isolated environment
    helper="$target/scripts/agent-profiles"
    ver=$(
      cd "$separate_cwd" && run_in_home "$home_dir" bash "$helper" --version
    )
    [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]] || fail "invalid version from $helper: $ver"

    doc_out=$(
      cd "$separate_cwd" && run_in_home "$home_dir" bash "$helper" doctor --json
    )
    python3 -c '
import json, sys
data = json.loads(sys.argv[1])
assert "version" in data, "missing version"
assert "checks" in data, "missing checks"
assert "agents" in data, "missing agents"
assert all(a in data["agents"] for a in ["claude", "codex", "agy", "opencode"]), "missing agent in doctor output"
' "$doc_out" || fail "doctor --json failed on $helper from separate cwd"

    # Verify init and run in separate fixture repo with isolated HOME
    (
      cd "$separate_cwd" && run_in_home "$home_dir" bash "$helper" init --profile check-prof
    ) || fail "init --profile check-prof failed on $helper from separate cwd"

    (
      cd "$separate_cwd" && run_in_home "$home_dir" bash "$helper" run --profile check-prof -- true
    ) || fail "run --profile check-prof -- true failed on $helper from separate cwd"
  done
done

echo "check-install: PASS - all clean installation checks verified"
