#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
LIB_DIR="$SCRIPT_DIR/lib"
COMMANDS_DIR="$LIB_DIR/commands"
SKILL_DIR="$(dirname "$SCRIPT_DIR")"
VERSION_FILE="$SKILL_DIR/VERSION"

# shellcheck source=skills/flyingnobita-agent-profiles/scripts/lib/common.sh
source "$LIB_DIR/common.sh"

usage() {
  cat <<'EOF'
Usage: agent-profiles [--help | --version] <command> [options] [arguments...]

Implemented commands:
  doctor   Diagnose host, OS, dependencies, and agent integrations
  init     Initialize a named agent profile for this checkout
  list     List existing agent profiles in this checkout

Planned commands (reserved for subsequent delivery tickets):
  run      Execute a command within an agent profile (ticket 02)
  setup    Configure machine dependencies and mise tasks (ticket 03)
  reset    Reset a profile to an empty initial state (ticket 08)
  remove   Delete an existing profile (ticket 08)
  migrate  Migrate legacy profile storage to current format (ticket 08)
  recover  Recover interrupted lifecycle operations (ticket 08)
EOF
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit "$EX_USAGE"
fi

case "$1" in
  --help | -h)
    usage
    exit "$EX_OK"
    ;;
  --version | -v)
    if [[ -f "$VERSION_FILE" ]]; then
      tr -d '[:space:]' <"$VERSION_FILE"
      echo
      exit "$EX_OK"
    else
      ap_die "$EX_BROKEN" "VERSION file missing"
    fi
    ;;
esac

cmd="$1"
shift

if [[ ! "$cmd" =~ ^[a-z][a-z-]{0,31}$ ]]; then
  ap_die "$EX_USAGE" "invalid command: $cmd"
fi

cmd_file="$COMMANDS_DIR/$cmd.sh"
if [[ ! -f "$cmd_file" ]]; then
  case "$cmd" in
    run | setup | reset | remove | migrate | recover)
      ap_die "$EX_USAGE" "command '$cmd' is not yet implemented (planned for subsequent tickets). Available commands: doctor, init, list"
      ;;
    *)
      ap_die "$EX_USAGE" "unknown command: $cmd. Available commands: doctor, init, list"
      ;;
  esac
fi

# shellcheck source=/dev/null
source "$cmd_file"
"ap_cmd_${cmd//-/_}" "$@"
